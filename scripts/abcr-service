#!/usr/bin/env python3
"""Fixture service doctor without mutating live launchd state."""
from __future__ import annotations
import argparse, importlib, json

def main():
    p=argparse.ArgumentParser(); p.add_argument("module"); p.add_argument("--doctor",action="store_true"); a=p.parse_args()
    module=importlib.import_module(a.module)
    entry=getattr(module,"main",None)
    if not callable(entry): raise SystemExit(f"{a.module} has no callable main()")
    if a.doctor: print(json.dumps({"ok":True,"module":a.module,"entrypoint":"main"})); return 0
    return int(entry() or 0)
if __name__ == "__main__": raise SystemExit(main())
