<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.abcr.seal-broker</string>
<key>ProgramArguments</key><array><string>/usr/local/libexec/abcr-bootstrap-selector</string><string>seal-broker</string></array>
<!-- Installer MUST add integer SockPathGroup resolved from abcr-broker-clients. -->
<key>Sockets</key><dict><key>Listener</key><dict><key>SockPathName</key><string>/var/run/abcr-seal-broker.sock</string><key>SockPathMode</key><integer>432</integer></dict></dict>
<key>WorkingDirectory</key><string>/var/empty</string><key>Umask</key><integer>63</integer>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/bin:/bin</string><key>PYTHONDONTWRITEBYTECODE</key><string>1</string><key>PYTHONNOUSERSITE</key><string>1</string></dict>
</dict></plist>
