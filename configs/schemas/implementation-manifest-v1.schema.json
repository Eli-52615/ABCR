{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"abcr://implementation-manifest-v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","authority_sha256","base_sha","branch","tier","nodes"],
  "properties":{
    "schema_version":{"const":1},
    "authority_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "base_sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},
    "branch":{"type":"string","minLength":1},
    "tier":{"enum":["CODE_RC","LIVE_PILOT","AUTONOMOUS_QUAL"]},
    "nodes":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true}
  }
}
