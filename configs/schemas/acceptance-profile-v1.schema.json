{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abcr://acceptance-profile-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "required_external_oracle_ids", "external_oracles", "in_candidate_diagnostics"],
  "properties": {
    "profile_id": {"type": "string"},
    "required_external_oracle_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string"}
    },
    "external_oracles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["oracle_id", "version", "request"],
        "properties": {
          "oracle_id": {"type": "string"},
          "version": {"type": "string"},
          "request": {"type": "object"},
          "timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 60},
          "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
        }
      }
    },
    "in_candidate_diagnostics": {"type": "array", "items": {"type": "string"}}
  }
}
