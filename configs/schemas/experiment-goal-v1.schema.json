{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abcr://experiment-goal-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_id", "title", "design_origin", "hypothesis", "template_id", "split", "personas", "arms", "predictions", "falsifier", "metrics", "item_count", "seeds", "max_cost_usd"],
  "properties": {
    "goal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "title": {"type": "string", "minLength": 1},
    "design_origin": {"const": "human_claude_manual"},
    "hypothesis": {"type": "string", "minLength": 1},
    "template_id": {"type": "string"},
    "split": {"const": "dev"},
    "personas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "arms": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "predictions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["task_family", "direction", "rationale"], "properties": {"task_family": {"type": "string"}, "direction": {"enum": ["increase", "decrease", "null", "mixed"]}, "rationale": {"type": "string"}}}},
    "falsifier": {"type": "string", "minLength": 1},
    "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "item_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}},
    "max_cost_usd": {"type": "number", "minimum": 0, "maximum": 10000},
    "parent_round_id": {"type": ["string", "null"]},
    "decision_rules": {"type": "object", "required": ["if_support", "if_refute"], "properties": {"if_support": {"type": "string"}, "if_refute": {"type": "string"}}}
  }
}
