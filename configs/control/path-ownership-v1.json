    "candidate_cannot_read_test_results",
    "candidate_cannot_write_source_or_result_spool",
    "operator_cannot_read_human_private_key",
    "probe_cannot_read_dataset",
    "builder_cannot_read_evidence_or_attest",
    "builder_reads_only_operator_exported_mission_input",
