# ABCR .env 模板 —— 复制为 .env 并填入真实 key(.env 已 gitignore,永不入库)
#   cp .env.example .env  然后编辑填 key
# 代码消费方式:os.environ.get("OPENAI_API_KEY"/"OPENAI_BASE_URL")(src/abcr/eval/judge/)。
# 无 load_dotenv 自动加载——用前在 shell 里:  set -a; source .env; set +a

# DeepSeek key(唯一真正必需的秘密;judge 与云日用)
DEEPSEEK_API_KEY=填你的_deepseek_key
# 同一个 DeepSeek key 的副本 —— vendor/judge 走 OpenAI SDK 零改道复用(设计:docB §.env)
OPENAI_API_KEY=填你的_deepseek_key
OPENAI_BASE_URL=https://api.deepseek.com

# HuggingFace 镜像(B 下模型用;直连 huggingface.co 会超时)
HF_ENDPOINT=https://hf-mirror.com
# HF_TOKEN 可选:vendor 补丁 D6 已把它可选化,W1 不训练可留空
HF_TOKEN=

# 状态目录(缺省 state/,一般不用改)
ABCR_STATE_DIR=state
