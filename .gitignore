# ---- 最小快道（lab/）：代码入 git，运行时产物与本地封印密钥不入 ----
# lab/fastlane/*.py 是源交付物，必须跟踪；lab/runs/ 是本机实验数据 + 自建
# 封印密钥（见下条密钥政策），一律不入 git。
/lab/runs/

# ---- 密钥政策：真实密钥永不入 git；唯一豁免 fixtures/test_approval.key（AMENDMENT-34 测试专用确定性密钥）----
/.env
state/approval.key
/cloud-results.sha256
# /reports/ 内一切运行时产物忽略；唯一例外 = C2-4 周证据模板（源交付物）。
# 用 /reports/* 而非 /reports/ 以便 git 能递归进子目录再对单文件反忽略（目录被整体
# 排除则无法反忽略其中文件——git 规则）。sync-*/triage-*/audit/ 仍全部忽略。
/reports/*
!/reports/weekly/
/reports/weekly/*
!/reports/weekly/TEMPLATE-weekly-evidence.md
# 0719 人格控制面硬门产物 = 源交付物(清单 hard_preconditions 要求入库),仅放行三份
!/reports/implementation/
/reports/implementation/*
!/reports/implementation/adoption-matrix.json
!/reports/implementation/path-ownership-validation.json
!/reports/implementation/preflight.json

# 运行/测试产物(信任根锚存储、跑批信封、复现包 demo)——不纳入版本
